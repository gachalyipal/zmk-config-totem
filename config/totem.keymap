//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        caps_1: caps_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp NUMBER_1>, <&macro_release &kp CAPSLOCK>;
        };
        caps_2: caps_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp NUMBER_2>, <&macro_release &kp CAPSLOCK>;
        };
        caps_3: caps_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp NUMBER_3>, <&macro_release &kp CAPSLOCK>;
        };
        caps_4: caps_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp NUMBER_4>, <&macro_release &kp CAPSLOCK>;
        };
        caps_q: caps_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp Q>, <&macro_release &kp CAPSLOCK>;
        };
        caps_w: caps_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp W>, <&macro_release &kp CAPSLOCK>;
        };
        caps_e: caps_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp E>, <&macro_release &kp CAPSLOCK>;
        };
        caps_r: caps_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp CAPSLOCK>, <&macro_tap &kp R>, <&macro_release &kp CAPSLOCK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            bindings = <
           &kp Q           &kp W           &kp E         &kp R        &kp T           &kp Y        &kp U        &kp I        &kp O            &kp P
           &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LSHIFT D  &mt LCTRL F  &kp G           &kp H        &mt RCTRL J  &mt RSHFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMICOLON
&kp GRAVE  &kp Z           &kp X           &kp C         &kp V        &kp B           &kp N        &kp M        &kp COMMA    &kp DOT          &kp FSLH                 &kp APOS
                                           &tog 4        &lt 2 TAB    &lt 1 BSPC    &lt 1 SPACE  &lt 2 ENTER  &mo 3
            >;
        };

        navigation {
            bindings = <
            &caps_1     &caps_2     &caps_3     &caps_4     &none     &kp F1   &kp F2       &kp F3       &kp F4     &kp F5
            &caps_q     &caps_w     &caps_e     &caps_r     &none     &kp F6   &mt F7 LEFT  &mt F8 DOWN  &mt F9 UP  &mt F10 RIGHT
&kp ESCAPE  &trans      &none       &none       &none       &none     &kp F11  &kp F12      &kp F13      &kp F14    &kp F15        &kp F16
                                    &trans      &trans      &trans    &none    &none        &none
            >;
        };

        mac_sym {
            bindings = <
        &kp LA(LS(COMMA))  &kp LS(N8)        &kp LS(MINUS)  &kp LS(N9)        &kp LA(LS(DOT))    &kp N5           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N9
        &trans             &kp LA(LS(N8))    &kp LS(N7)     &kp LA(LS(N9))    &kp LS(N6)         &kp KP_NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp N4
&trans  &trans             &kp LA(N8)        &kp LA(N1)     &kp LA(N9)        &kp LA(LS(Q))      &kp LA(LS(W))    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans  &trans
                                             &trans         &trans            &trans             &trans           &trans        &trans
            >;
        };

        device {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &out OUT_TOG  &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        windows {
            bindings = <
          &kp Q           &kp W           &kp E         &kp R        &kp T           &kp Y        &kp U        &kp I        &kp O            &kp P
          &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LSHIFT D  &mt LCTRL F  &kp G           &kp H        &mt RCTRL J  &mt RSHFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMICOLON
&kp NUBS  &kp Z           &kp X           &kp C         &kp V        &kp B           &kp N        &kp M        &kp COMMA    &kp DOT          &kp FSLH                 &kp APOS
                                          &tog 4        &lt 5 TAB    &lt 1 BSPC    &lt 1 SPACE  &lt 5 ENTER  &mo 3
            >;
        };

        win_sym {
            bindings = <
        &kp RA(A)  &kp LS(N8)  &kp LS(MINUS)  &kp LS(N9)  &kp RA(S)      &kp N5           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N9
        &trans     &kp RA(B)   &kp LS(N7)     &kp RA(N)   &kp LS(N6)     &kp KP_NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp N4
&trans  &trans     &kp RA(F)   &kp RA(N1)     &kp RA(G)   &kp RA(Q)      &kp RA(W)        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans  &trans
                               &trans         &trans      &trans         &trans           &trans        &trans
            >;
        };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device_mac {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        device_win {
            if-layers = <1 5>;
            then-layer = <3>;
        };
    };
};
